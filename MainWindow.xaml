<Window x:Class="WpfProgram_DAQ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfProgram_DAQ"
        mc:Ignorable="d"
        Title="串口调试助手" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition  Height="150"/>
            <RowDefinition  Height="*"/>
            <RowDefinition  Height="*"/>
            <RowDefinition  Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource borderStyle}">
            <Grid Grid.Column="0" Grid.Row="0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Label Grid.Column="0" Grid.Row="0" Style="{StaticResource labelStyle}">
                端口：
            </Label>
            <Label Grid.Column="0" Grid.Row="1" Style="{StaticResource labelStyle}">
                数据位：
            </Label>
            <ComboBox x:Name="port" Grid.Column="1" Grid.Row="0" Style="{StaticResource comboBoxStyle}">
                
            </ComboBox>
            <ComboBox x:Name="data_bits" Grid.Column="1" Grid.Row="1" Style="{StaticResource comboBoxStyle}">
                
            </ComboBox>
            <Label Grid.Column="2" Grid.Row="0" Style="{StaticResource labelStyle}">
                波特率：
            </Label>
            <Label Grid.Column="2" Grid.Row="1" Style="{StaticResource labelStyle}">
                效验位：
            </Label>
            <ComboBox x:Name="baud_rate" Grid.Column="3" Grid.Row="0" Style="{StaticResource comboBoxStyle}">

            </ComboBox>
            <ComboBox x:Name="check_digit" Grid.Column="3" Grid.Row="1" Style="{StaticResource comboBoxStyle}">

            </ComboBox>
            <Button x:Name="but_apply" Grid.Column="4" Grid.Row="0" Style="{StaticResource buttonStyle}">
                应用
            </Button>
            <Label Grid.Column="4" Grid.Row="1" Style="{StaticResource labelStyle}">
                停止位：
            </Label>
            <ComboBox x:Name="stop_bit" Grid.Column="5" Grid.Row="1" Style="{StaticResource comboBoxStyle}">

            </ComboBox>
            <StackPanel Grid.Column="5" Grid.Row="0"  Orientation="Horizontal">
                <CheckBox Style="{StaticResource checkBoxStyle}"></CheckBox>
                <Label Style="{StaticResource labelStyle}" Margin="5,0,5,0">DTR</Label>
            </StackPanel>
            <StackPanel Grid.Column="6" Grid.Row="0"  Orientation="Horizontal">
                <CheckBox Style="{StaticResource checkBoxStyle}"></CheckBox>
                <Label Style="{StaticResource labelStyle}" Margin="5,0,5,0">RTS</Label>
            </StackPanel>
            <Button Grid.Column="7" Grid.Row="0" Style="{StaticResource buttonStyle}">
                打开串口
            </Button>
            <StackPanel Grid.Column="6" Grid.Row="1"  Orientation="Horizontal">
                <CheckBox Style="{StaticResource checkBoxStyle}"></CheckBox>
                <Label HorizontalContentAlignment="Center" VerticalAlignment="Center">无额外效验</Label>
            </StackPanel>
            <Button Grid.Column="7" Grid.Row="1" Style="{StaticResource buttonStyle}">
                暂停显示
            </Button>
        </Grid>
        </Border>
        <Border Style="{StaticResource borderStyle}" Grid.Column="0" Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Button Grid.Column="0" Grid.Row="0" FontSize="15">
                        输入HEX
                    </Button>
                    <Button Grid.Column="1" Grid.Row="0" FontSize="15">
                        显示HEX
                    </Button>
                    <Button Grid.Column="0" Grid.Row="1" FontSize="15">
                        显示ASC
                    </Button>
                    <Button Grid.Column="1" Grid.Row="1" FontSize="15">
                        显示ASC
                    </Button>
                </Grid>
                <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel  Orientation="Horizontal" Grid.Column="0">
                            <CheckBox Style="{StaticResource checkBoxStyle}">

                            </CheckBox>
                            <Label Style="{StaticResource labelStyle}" FontSize="15">
                                忽略空格输入
                            </Label>
                        </StackPanel>
                        <StackPanel  Orientation="Horizontal" Grid.Column="1">
                            <CheckBox Style="{StaticResource checkBoxStyle}" >

                            </CheckBox>
                            <Label Style="{StaticResource labelStyle}">
                                自动换行
                            </Label>
                        </StackPanel>
                        <StackPanel  Orientation="Horizontal" Grid.Column="2">
                            <CheckBox Style="{StaticResource checkBoxStyle}">

                            </CheckBox>
                            <Label Style="{StaticResource labelStyle}">
                                显示间隔
                            </Label>
                        </StackPanel>
                    </Grid>
                </Border>
                <Button Style="{StaticResource buttonStyle}" Grid.Column="3">
                    清除显示
                </Button>
            </Grid>
        </Border>
        <Border Style="{StaticResource borderStyle}" Grid.Column="0" Grid.Row="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <RichTextBox Grid.Column="0" Margin="10">
                </RichTextBox>
                <Button Style="{StaticResource buttonStyle}" Grid.Column="1" Width="100">
                    发送
                </Button>
            </Grid>
        </Border>
        <Border Style="{StaticResource borderStyle}" Grid.Column="0" Grid.Row="3">
            <RichTextBox Margin="10" IsReadOnly="True">
                
            </RichTextBox>
        </Border>
    </Grid>

    
</Window>
